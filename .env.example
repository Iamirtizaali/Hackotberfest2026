MONGODB_URI=
MONGODB_DB=
JWT_SECRET_KEY=
LOCAL_MONGODB=mongodb://localhost:27017/trello
SENDGRID_API_KEY=
NEXT_PUBLIC_UNSPLASH_API=
# DeepSeek V4.1 Flash, here served by Hive (a DeepSeek key works too with DEEPSEEK_BASE_URL unset)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api-cdn.thehive.ai/api/v3
DEEPSEEK_MODEL=deepseek-ai/deepseek-v4.1-flash-1017
DEEPSEEK_REASONING_EFFORT=low
# Hardcoded demo logins (util/demo-accounts.js); set to off to disable
DEMO_ACCOUNTS=on
# Absolute app URL for server-side API calls (optional on Vercel)
APP_URL=
